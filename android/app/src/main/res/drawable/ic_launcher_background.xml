<?xml version="1.0" encoding="utf-8"?>
<!-- Tło adaptacyjnej ikony (Android 8+) - ten sam radialny gradient co
     #loading-screen w style.css (tonacja łąki Strefy A: #86c46e -> #6fae5b
     -> #4a7a3d), żeby ikona na ekranie głównym i ekran ładowania w apce
     czytały się jako JEDNA spójna marka, nie dwa przypadkowe kolory.
     ZASTĘPUJE poprzednią, nigdy nie podpiętą (patrz ic_launcher*.xml -
     odwoływały się do @color/ic_launcher_background, nie @drawable/...)
     domyślną kratkę szablonu Android Studio. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="80dp"
        android:centerX="0.5"
        android:centerY="0.4"
        android:startColor="#86C46E"
        android:centerColor="#6FAE5B"
        android:endColor="#4A7A3D" />
</shape>
